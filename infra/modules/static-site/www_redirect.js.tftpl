// Sends www.${domain} to https://${domain}, keeping the path and query string. A CloudFront Function
// (viewer request, cloudfront-js-2.0): it answers at the edge, so a visitor typing "www." lands on the
// real site in one hop and nothing reaches S3. It only acts on that exact host, and the target is
// fixed, so it cannot be turned into an open redirect by a forged Host header.
function handler(event) {
  var request = event.request;
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : "";
  if (host !== "www.${domain}") {
    return request;
  }
  var pairs = [];
  var query = request.querystring || {};
  Object.keys(query).forEach(function (key) {
    var entry = query[key];
    if (entry.multiValue) {
      entry.multiValue.forEach(function (item) {
        pairs.push(key + "=" + item.value);
      });
    } else {
      pairs.push(key + "=" + entry.value);
    }
  });
  return {
    statusCode: 301,
    statusDescription: "Moved Permanently",
    headers: {
      location: { value: "https://${domain}" + request.uri + (pairs.length ? "?" + pairs.join("&") : "") },
    },
  };
}
